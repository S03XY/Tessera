# ---------------------------------------------------------------------------
# Database
# Local dev: docker postgres on 5433 (npm run db:up)
# Production: paste the Supabase *connection pooler* URI (port 6543, ?pgbouncer=true)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://tollgate:tollgate@localhost:5433/tollgate

# ---------------------------------------------------------------------------
# x402 / Blocky402 facilitator (Hedera testnet)
# ---------------------------------------------------------------------------
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet

# ---------------------------------------------------------------------------
# Hedera operator (marketplace treasury + HCS receipts)
# Get a testnet account at https://portal.hedera.com
# ---------------------------------------------------------------------------
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_RECEIPT_TOPIC_ID=

# Public marketplace base URL (used to build absolute `resource` URLs in 402s)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Buyer agent (optional). A funded Hedera testnet account the demo agent
# spends from. Without these the agent runs discovery and quoting but stops
# before payment rather than faking one.
# ---------------------------------------------------------------------------
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# World ID Selfie Check (seller sybil gate).
# Selfie Check is feature-gated: request access for your app from World before
# it will work, including in the Sandbox App.
# Create the app and RP at https://developer.world.org
# ---------------------------------------------------------------------------
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=become-seller
WORLD_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# The Graph (free tier: 100k queries/month, no card) — thegraph.com/studio
# ---------------------------------------------------------------------------
GRAPH_API_KEY=

# ERC-1400 seller deposit bond issued through Asset Tokenization Studio.
# See ../tollgate-ats. Reading balances needs no SDK, only the JSON-RPC relay.
DEPOSIT_BOND_TOKEN_ID=

# ---------------------------------------------------------------------------
# Agent spending mandate on 1inch Aqua (optional)
#
# Aqua is deployed on Base and Arbitrum mainnet only — there is no testnet
# deployment — so point these at wherever TollgateSwapVMRouter was deployed.
# Left blank, the agent falls back to the per-call cap it enforces itself and
# every surface says which of the two is in force.
#
# For local development: run `anvil --fork-url https://mainnet.base.org`,
# deploy the router from contracts/swap-vm, and point MANDATE_RPC_URL at it.
# ---------------------------------------------------------------------------
MANDATE_ROUTER=
MANDATE_OWNER=
MANDATE_ORDER_HASH=
MANDATE_ID=7
MANDATE_DAILY_CAP=
MANDATE_CHAIN=base
MANDATE_RPC_URL=https://mainnet.base.org

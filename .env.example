# ---------------------------------------------------------------------------
# Database
# Local dev: docker postgres on 5433 (npm run db:up)
# Production: paste the Supabase *connection pooler* URI (port 6543, ?pgbouncer=true)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://tollgate:tollgate@localhost:5433/tollgate

# ---------------------------------------------------------------------------
# x402 / Blocky402 facilitator (Hedera testnet)
# ---------------------------------------------------------------------------
X402_FACILITATOR_URL=https://api.testnet.blocky402.com
X402_NETWORK=hedera:testnet

# ---------------------------------------------------------------------------
# Hedera operator (marketplace treasury + HCS receipts)
# Get a testnet account at https://portal.hedera.com
# ---------------------------------------------------------------------------
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_RECEIPT_TOPIC_ID=

# Public marketplace base URL (used to build absolute `resource` URLs in 402s)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Buyer agent (optional). A funded Hedera testnet account the demo agent
# spends from. Without these the agent runs discovery and quoting but stops
# before payment rather than faking one.
# ---------------------------------------------------------------------------
AGENT_ACCOUNT_ID=
AGENT_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# World ID (seller sybil gate). Create the app at https://developer.world.org
#
# WORLD_RP_ID and WORLD_RP_SIGNING_KEY are issued together when the app is
# migrated to World ID 4.0 ("Enable World ID 4.0" in the portal). The signing
# key is shown once and never leaves the server. WORLD_ACTION must exist as an
# Incognito Action under the app, or every request is refused.
#
# Verify all of the above without a phone:  npm run world:preflight
#
# WORLD_CREDENTIAL picks which credential the gate demands:
#   selfie_check     face capture      ACCESS-GATED by World — request it first
#   proof_of_human   World ID 4.0, Orb fallback
#   orb              in-person iris verification
#   document         verified identity document
#   secure_document  chip-verified identity document
#   passport         passport, World ID 4.0
#   device           a distinct World App install (weak: one human, many devices)
# Every option runs the identical live path; only the assurance level differs.
# ---------------------------------------------------------------------------
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
WORLD_ACTION=become-seller
WORLD_CREDENTIAL=selfie_check
# production | staging | sandbox. Use `sandbox` to test against the Sandbox App
# (same app_id, same rp_id, same verify endpoint — only this value changes).
WORLD_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# The Graph (free tier: 100k queries/month, no card) — thegraph.com/studio
# ---------------------------------------------------------------------------
GRAPH_API_KEY=

# ERC-1400 seller deposit bond issued through Asset Tokenization Studio.
# See ../tollgate-ats. Reading balances needs no SDK, only the JSON-RPC relay.
DEPOSIT_BOND_TOKEN_ID=

# ---------------------------------------------------------------------------
# Gemini, for the demo buying agent (scripts/agent-gemini.mjs).
# Free key from https://aistudio.google.com/apikey — used only by that script,
# never by the marketplace itself.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
